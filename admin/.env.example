# Copy this file to .env and adjust for your environment. .env itself is
# gitignored and must never be committed.

# Backend API base URL this admin panel talks to. Falls back to the
# production demo backend (https://api.demand24.org) if unset - see
# src/configs/app-global.js.
VITE_BASE_URL=https://api.demand24.org

# This deployment's own storefront (the `web/` Next.js app) URL - used by
# the UI-type "preview" link in Settings and the order-tracking QR code.
# Falls back to the original vendor's demo site (https://demand24.org) if
# unset - see src/configs/app-global.js.
VITE_WEBSITE_URL=https://your-storefront-domain.example

# Google Maps API key used by address/location pickers - see
# src/helpers/getMapApiKey.js.
VITE_MAP_API_KEY=

# Shows demo-mode UI (e.g. read-only notices) when set to "true".
VITE_IS_DEMO=false
